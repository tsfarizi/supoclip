# SupoClip ASR Service Environment Configuration
# Copy this file to .env and adjust as needed.

# ==============================================
# Model Configuration
# ==============================================

# Qwen3-ASR transcription model (HuggingFace repo id).
# Downloaded into HF_HOME on first boot.
ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# Forced-aligner model used for word-level timestamps.
ASR_ALIGNER=Qwen/Qwen3-ForcedAligner-0.6B

# ==============================================
# Service
# ==============================================

# Port the uvicorn server binds inside the container.
ASR_PORT=8765

# HTTP timeout for one transcription request, in seconds.
# Larger audio or slow GPUs may need this raised.
ASR_REQUEST_TIMEOUT_SECONDS=600

# Maximum accepted audio upload size in MB. Larger uploads are
# rejected with AUDIO_TOO_LARGE (HTTP 413).
MAX_AUDIO_MB=64

# ==============================================
# Model Cache
# ==============================================

# HuggingFace cache root. Inside the container this points at the
# asr_models named volume; keep the default unless you know why
# you need to change it.
HF_HOME=/models

# ==============================================
# Development Only
# ==============================================

# DEV-ONLY: set to true/1/yes to load a fake in-process model instead of
# downloading real weights. Never enable in production.
ASR_FAKE_MODEL=0
